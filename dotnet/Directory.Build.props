<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- One version for every NuGet package: the release they last shipped in. scripts/release.sh bump moves it only
         when they changed since, so it can trail the tag. -->
    <LachingVersion Condition="'$(LachingVersion)' == ''">0.17.1</LachingVersion>
    <Version>$(LachingVersion)</Version>
    <Authors>Vlad Mihalachi</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vmihalachi/laching</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vmihalachi/laching</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>tray;menubar;desktop;idle;busy;scheduler;winui</PackageTags>
  </PropertyGroup>
</Project>
