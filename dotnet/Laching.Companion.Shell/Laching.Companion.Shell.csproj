<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Consumers publish with Native AOT; this runs the trim and AOT analyzers here too. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Laching.Companion.Shell</PackageId>
    <Description>The platform-free half of a desk-companion app's shell, the C# twin of the Swift LachingCompanionUI's logic: the app model (the tick, the channels, Shh and wake, the bubble with mute and undo, previews, the status line, the desktop character), the menus as data, speech in parts with recorded voices, the delivery performer, the signal hub, the desktop layout and placement, a screenshot run's sample environment. Written against small interfaces (a host for the tray icon, windows, desktop window and timers; speaker, chime, notifier, signal sources) that Laching.Windows.Companion implements, so it is tested on any OS. No OS or UI dependencies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Laching.Core\Laching.Core.csproj" />
    <ProjectReference Include="..\Laching.Companion\Laching.Companion.csproj" />
    <InternalsVisibleTo Include="Laching.Companion.Shell.Tests" />
  </ItemGroup>
</Project>
