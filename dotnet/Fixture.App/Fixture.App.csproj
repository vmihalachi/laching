<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>FixtureApp</RootNamespace>
    <!-- The name notifications show for an unpackaged app. -->
    <AssemblyTitle>Laching fixture</AssemblyTitle>
    <IsPackable>false</IsPackable>
    <!-- Unpackaged in every configuration (the apps' Release is an MSIX): the installed Windows App Runtime in Debug,
         its own copy in Release. -->
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Laching.Windows.Companion\Laching.Windows.Companion.csproj" />
    <!-- The fixture bank, defaults and art. -->
    <ProjectReference Include="..\Laching.Testing\Laching.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\conformance\companion\phrases.json" Link="conformance\companion\phrases.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\conformance\companion\characters\fixture-vector.json" Link="conformance\companion\characters\fixture-vector.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\conformance\companion\characters\fixture-raster.json" Link="conformance\companion\characters\fixture-raster.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The raster fixture's layers under Windows' names for scaled images (head@2x.png is fixture-raster.head.scale-200.png). -->
    <Content
      Include="..\..\Tests\Fixtures\characters\fixture-raster\layers\*.png"
      Link="Assets\Characters\fixture-raster.$([System.String]::Copy('%(Filename)').Replace('@2x', '.scale-200').Replace('@3x', '.scale-300'))%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- What every companion's WinUI project has, as the apps take it from their laching/ submodule: x64 and ARM64,
       Main left to CompanionApp.Start, Native AOT on publish (tools/windows/companion.targets). -->
  <Import Project="../../tools/windows/companion.targets" />
</Project>
