{
  "patterns": [
    "\\.(cs|razor|cshtml|resx|csproj|props|targets)$",
    "\\.swift$",
    "\\.(kt|kts)$",
    "\\.(sh|yml)$",
    "^(Sources|Tests|dotnet|tools)/.*\\.(py|json)$",
    "^site/",
    "^scripts/"
  ],
  "exclude": [
    "/(bin|obj)/"
  ],
  "checks": [
    [
      "scripts/verify.sh",
      "--fast"
    ]
  ]
}
