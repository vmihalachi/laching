#!/bin/sh
# Fast checks on the staged files (formatting, the version strings, the tools tests that cover them). Seconds, not
# minutes: swift test, dotnet test and Gradle are left to scripts/verify.sh without --fast, and CI.
# Enable once per clone: git config core.hooksPath .githooks
# Skip for one commit: git commit --no-verify
exec "$(git rev-parse --show-toplevel)/scripts/verify.sh" --fast --staged
