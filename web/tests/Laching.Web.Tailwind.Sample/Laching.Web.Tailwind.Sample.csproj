<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Built by scripts/tailwind-sample.sh against the packed Laching.Web.Tailwind, never by the solution. CI builds it on
    Linux, Windows and macOS.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Laching.Web.Tailwind" Version="$(LachingWebTailwindVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
