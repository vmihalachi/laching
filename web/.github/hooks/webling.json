{
  "version": 1,
  "hooks": {
    "preToolUse": [
      { "type": "command", "bash": "python3 .claude/hooks/guard.py", "powershell": "python .claude/hooks/guard.py", "cwd": ".", "timeoutSec": 10 }
    ],
    "postToolUse": [
      { "type": "command", "bash": "python3 -I .claude/hooks/validate.py record", "powershell": "python -I .claude/hooks/validate.py record", "cwd": ".", "timeoutSec": 5 }
    ],
    "agentStop": [
      { "type": "command", "bash": "python3 -I .claude/hooks/validate.py check", "powershell": "python -I .claude/hooks/validate.py check", "cwd": ".", "timeoutSec": 600 }
    ]
  }
}
